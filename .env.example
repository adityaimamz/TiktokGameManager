# Neon Postgres. Kosongkan untuk menjalankan server tanpa database.
DATABASE_URL=

# Database TERPISAH untuk `npm test`. Test repository menjalankan TRUNCATE atas kelima
# tabel, jadi mengarahkannya ke DATABASE_URL akan menghapus katalog gift dan riwayat match.
# Kosong = test repository dilewati; diisi sama dengan DATABASE_URL = dilempar, bukan dijalankan.
TEST_DATABASE_URL=

# Port server Express + WebSocket. Default 3001.
PORT=3001

# Opsional: kunci EulerStream untuk penandatanganan TikTok. Kosong = free tier.
EULER_API_KEY=

# Origin halaman saat halaman dan server BEDA host (mis. client di Vercel).
# Kosong = satu origin, tanpa header CORS.
CORS_ORIGIN=

# Kunci yang menjaga /api dan /ws saat aplikasi dideploy publik.
# Kosong = semua terbuka, persis dev lokal. Diisi = dashboard dibuka sekali dengan
# ?k=<kunci>, dan URL overlay OBS membawa &k=<kunci> selamanya.
APP_KEY=

# Satu-satunya cara menjalankan server TANPA APP_KEY. Wajib diisi untuk dev lokal;
# JANGAN pernah disetel di deploy publik — ia membuka panel kontrol penuh untuk siapa pun
# yang menemukan alamatnya. Hanya nilai persis "1" yang menyalakannya.
ALLOW_OPEN_ACCESS=1

# Hasil build client yang ikut disajikan Express (satu deployment).
# Default 'packages/client/dist' relatif cwd — biasanya tidak perlu diisi.
CLIENT_DIST=
